# For description of KEYS and corresponding values  see Config documentation:
# https://ta-dah.readthedocs.io/en/latest/config.html

DBFILE tdata.db

ATOM Ta
WATOM 73

INIT2B true
TYPE2B D2_Blip 4 4 Ta Ta

RCUT2B 5.3

FORCE false
STRESS true

SGRID2B GEOM 4 0.1 1.0
CGRID2B LIN 4 1.0 5.3

LAMBDA 1e-8
BIAS true
NORM false
VERBOSE 2

ESIGMA 1     # energies per atom to 1 meV/atom (the default)
SSIGMA 0.5   # stresses to 0.5 GPa (the default)
