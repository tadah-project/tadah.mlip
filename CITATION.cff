license: GPL-3.0-only
repository-code: "https://git.ecdf.ed.ac.uk/tadah/tadah.mlip"
url: "https://tadah.readthedocs.io/"
keywords:
  - machine-learning interatomic potentials
  - molecular dynamics
  - LAMMPS
  - hyperparameter optimisation
  - computational materials science
