#!/bin/sh

echo "************************************************************************"
echo "                   WARNING"
echo "                   WORK IN PROGRESS"
echo Compilation with make does NOT work.
echo Make will compile without error but won\'t compile and link
echo libtadah.lammps to necessary cmrc library. 
echo Use CMake instead. This works fine.
echo You might need to remove build directory before running cmake.
echo "************************************************************************"

# CORE, MODELS and MD are the directories core, models and md of the Tadah!
# repository, beside this one; build/ gets a link to each. Both checks come
# before anything is created.
for module in core models md; do
  if [ ! -d "../$module" ]; then
    echo "configure: ../$module not found: Tadah.LAMMPS is built from inside the Tadah! repository" >&2
    exit 1
  fi
  if [ -e "build/$module" ] && [ ! -L "build/$module" ]; then
    echo "configure: build/$module exists and is not a link to ../$module: the make files would read it in place of the repository's $module. Without the directory build/, configure links the repository's directories" >&2
    exit 1
  fi
done
mkdir -p build
for module in core models md; do
  ln -sfn "../../$module" "build/$module"
done

cp Makefile.in Makefile
sed -i '1s/^/TADAH_MD_CONFIGURED=true\n/' Makefile
echo Configure done!
echo Run make to compile
